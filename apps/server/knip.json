{
  "$schema": "https://unpkg.com/knip@6.37.0/schema.json",
  "entry": [
    "next.config.ts",
    "drizzle.config.ts",
    "src/instrumentation.ts",
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/**/*.test.ts",
    "src/test/**",
    "src/lib/api/schemas.typecheck.ts",
    "src/lib/api/types.ts"
  ],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn"
  }
}
