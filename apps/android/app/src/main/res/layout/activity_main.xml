<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    tools:ignore="Overdraw">

    <!-- WebView is added in code so it can be recreated if its renderer crashes. -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Setup wizard: shown when no config exists, or from the exit menu to change servers. Content stays in
         the top ~300dp so the landscape keyboard (bottom half) never covers the address field or its error. -->
    <FrameLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            style="@style/Logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:id="@+id/setup_intro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:paddingTop="100dp"
            android:paddingBottom="42dp">

            <TextView
                style="@style/Text.Step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_step_intro" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_intro_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="660dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_intro_body" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/setup_intro_ok"
                style="@style/Button.Primary"
                android:text="@string/setup_intro_ok" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/setup_server"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="48dp"
                android:paddingTop="92dp"
                android:paddingBottom="42dp">

                <TextView
                    style="@style/Text.Step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_step_server" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_server_title" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/setup_server_body" />

                <EditText
                    android:id="@+id/setup_url"
                    style="@style/Field"
                    android:layout_marginTop="16dp"
                    android:autofillHints=""
                    android:hint="@string/setup_url_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/setup_secret"
                    style="@style/Field"
                    android:layout_marginTop="10dp"
                    android:autofillHints=""
                    android:hint="@string/setup_secret_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:inputType="textPassword"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/setup_error"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/danger"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/setup_note"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Connect leads as the one violet action; Cancel is a quiet text link after it. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="ButtonOrder">

                    <Button
                        android:id="@+id/setup_connect"
                        style="@style/Button.Primary"
                        android:text="@string/setup_connect" />

                    <Button
                        android:id="@+id/setup_cancel"
                        style="@style/Button.Text"
                        android:layout_marginStart="32dp"
                        android:text="@string/setup_cancel"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/setup_version"
            style="@style/Text.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="30dp"
            android:textColor="@color/graphite"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Shown by the watchdog while the server is unreachable. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone">

        <ImageView
            style="@style/Logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="48dp">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/signal" />

            <TextView
                android:id="@+id/overlay_title"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/reconnecting" />

            <TextView
                android:id="@+id/overlay_error"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/overlay_body"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="8dp"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
    <!-- Long-press (3 s) here to open the exit menu. Transparent; screens are read-only anyway. -->
    <View
        android:id="@+id/exit_hotspot"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/exit_menu_title" />

    <!-- Kiosk exit menu. -->
    <FrameLayout
        android:id="@+id/exit_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_menu"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Top of the screen so the number pad (bottom half in landscape) never covers the PIN row. -->
        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/menu_panel"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_menu_title"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/exit_status"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAllCaps="true"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/exit_pin_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/exit_pin"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/exit_pin_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="numberPassword"
                    android:maxLength="8" />

                <Button
                    android:id="@+id/exit_pin_ok"
                    style="@style/Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/exit_unlock" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exit_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/exit_choose_home"
                    style="@style/Button.Outline"
                    android:text="@string/exit_choose_home" />

                <Button
                    android:id="@+id/exit_settings"
                    style="@style/Button.Outline"
                    android:text="@string/exit_open_settings" />

                <Button
                    android:id="@+id/exit_leave_strict"
                    style="@style/Button.Outline"
                    android:text="@string/exit_leave_strict" />

                <Button
                    android:id="@+id/exit_change_server"
                    style="@style/Button.Outline"
                    android:text="@string/exit_change_server" />

                <Button
                    android:id="@+id/exit_reload"
                    style="@style/Button.Outline"
                    android:text="@string/exit_reload" />
            </LinearLayout>

            <TextView
                android:id="@+id/exit_message"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/warning" />

            <Button
                android:id="@+id/exit_close"
                style="@style/Button.Text"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/exit_close"
                android:textColor="@color/signal_tint" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
