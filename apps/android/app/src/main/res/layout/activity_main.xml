<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:ignore="Overdraw">

    <!-- WebView is added in code so it can be recreated if its renderer crashes. -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Setup wizard: shown when no config exists, or from the exit menu to change servers. -->
    <FrameLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/setup_intro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="96dp"
            android:paddingVertical="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_intro_title"
                android:textColor="#000000"
                android:textSize="56sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="@string/setup_intro_body"
                android:textColor="#222222"
                android:textSize="24sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/setup_intro_ok"
                android:layout_width="440dp"
                android:layout_height="64dp"
                android:text="@string/setup_intro_ok"
                android:textSize="22sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/setup_server"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="96dp"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_server_title"
                    android:textColor="#000000"
                    android:textSize="56sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setup_server_body"
                    android:textColor="#222222"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/setup_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:autofillHints=""
                    android:gravity="center"
                    android:hint="@string/setup_url_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="#000000"
                    android:textColorHint="#9A9A9A"
                    android:textSize="28sp" />

                <EditText
                    android:id="@+id/setup_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:autofillHints=""
                    android:gravity="center"
                    android:hint="@string/setup_secret_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="#000000"
                    android:textColorHint="#9A9A9A"
                    android:textSize="24sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/setup_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="#E5261F"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/setup_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#777777"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/setup_connect"
                    android:layout_width="440dp"
                    android:layout_height="64dp"
                    android:text="@string/setup_connect"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/setup_cancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/setup_cancel"
                    android:textColor="#444444"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/setup_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:textColor="#444444"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- Shown by the watchdog while the server is unreachable. -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reconnecting"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/overlay_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="#9AA3B2"
            android:textSize="18sp" />
    </LinearLayout>
    <!-- Long-press (3 s) here to open the exit menu. Transparent; screens are read-only anyway. -->
    <View
        android:id="@+id/exit_hotspot"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/exit_menu_title" />

    <!-- Kiosk exit menu. -->
    <FrameLayout
        android:id="@+id/exit_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Top of the screen so the number pad (bottom half in landscape) never covers the PIN row. -->
        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="#FF14181F"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_menu_title"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/exit_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#9AA3B2"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/exit_pin_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/exit_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/exit_pin_hint"
                    android:imeOptions="actionDone"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7382"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/exit_pin_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_unlock" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exit_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/exit_choose_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_choose_home" />

                <Button
                    android:id="@+id/exit_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_open_settings" />

                <Button
                    android:id="@+id/exit_leave_strict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_leave_strict" />

                <Button
                    android:id="@+id/exit_change_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_change_server" />

                <Button
                    android:id="@+id/exit_reload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_reload" />
            </LinearLayout>

            <TextView
                android:id="@+id/exit_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FFCF7A"
                android:textSize="15sp" />

            <Button
                android:id="@+id/exit_close"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/exit_close" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
