# Copy to .env and fill in. docker compose reads it automatically.

# Dashboard login (single admin user).
ADMIN_PASSWORD=change-me
# Sent by the Android app in the X-Kiosk-Secret header. Generate with: openssl rand -hex 32
DEVICE_SHARED_SECRET=change-me

# Weather (Open-Meteo, no key needed). Longitude is negative for west.
WEATHER_LAT=34.0522
WEATHER_LON=-118.2437
# imperial (°F, mph) or metric (°C, km/h)
WEATHER_UNITS=imperial
# IANA timezone used for time on screens
KIOSK_TIMEZONE=America/Los_Angeles

# AI screen generation (optional). Any OpenAI-compatible Chat Completions API:
# OpenRouter (default), OpenAI, or a local Ollama / LM Studio (e.g. http://host:11434/v1).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=google/gemini-3.8-flash

# Host port to expose
SHOWRUNNER_PORT=3000
